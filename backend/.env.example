# Database Connection (PostgreSQL)
# For local development:
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_ats
# For hosted database (e.g. Supabase, Neon, Render Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# JWT Authentication
JWT_SECRET=generate_a_secure_random_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# App Settings
DEBUG=False
APP_NAME="AI ATS Backend"
APP_VERSION=1.0.0
UPLOAD_DIR=uploads

# Cloud Storage for Resumes (Optional - e.g. Supabase Storage for 100% persistent files)
# If left empty, files are saved to local uploads/ directory.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=resumes
